{
  "name": "project-60",
  "version": "0.1.0",
  "private": true,
  "description": "project 60 white-label digital family and friends edition of BBC's Just a Minute game format",
  "scripts": {
    "dev": "npm run obfuscate && next dev",
    "dev:test": "next dev",
    "build": "npm run obfuscate && next build",
    "start": "next start",
    "lint": "next lint",
    "obfuscate": "node obfuscate.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "javascript-obfuscator": "^5.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
